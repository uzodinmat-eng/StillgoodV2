# Leave DATABASE_URL empty to use local PGlite at `.data/stillgood`.

# Hosted Supabase Postgres. Prefer Session pooler (port 5432), IPv4-friendly:
# postgresql://postgres.<project-ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
# Encode special characters in the password (e.g. ! → %21). Do not keep [brackets] from the dashboard template.
DATABASE_URL=

# Auth (email + Google). Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser or commit this file.
SUPABASE_SERVICE_ROLE_KEY=

# Google Client ID/secret belong in Supabase Dashboard → Authentication → Providers → Google,
# not in this app. Redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
